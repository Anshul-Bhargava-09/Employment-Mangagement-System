import React, { useState } from "react";
function AdminEmployeePage() {
    const items = [
    { id: 1, name: "Laptop", category: "Electronics" },
    { id: 2, name: "iPhone", category: "Electronics" },
    { id: 3, name: "Apple", category: "Fruits" },
    { id: 4, name: "Banana", category: "Fruits" },
    { id: 5, name: "Shirt", category: "Clothing" },
    { id: 6, name: "Jeans", category: "Clothing" },
  ];

  // State for search input
  const [search, setSearch] = useState("");

  // State for selected category
  const [category, setCategory] = useState("All");

  // Filter items
  const filteredItems = items.filter((item) => {
    // Search by name
    const matchSearch = item.name
      .toLowerCase()
      .includes(search.toLowerCase());

    // Filter by category
    const matchCategory =
      category === "All" || item.category === category;

    // Return items that satisfy both conditions
    return matchSearch && matchCategory;
  });
    return (  
        <>
       <div style={{ padding: "20px" }} className="main-content">
      <h2>Search & Filter Example</h2>

      {/* Search Input */}
      <input
        type="text"
        placeholder="Search item..."
        value={search}
        onChange={(e) => setSearch(e.target.value)}
        style={{
          padding: "8px",
          width: "200px",
          marginRight: "10px",
        }}
      />

      {/* Category Dropdown */}
      <select
        value={category}
        onChange={(e) => setCategory(e.target.value)}
        style={{ padding: "8px" }}
      >
        <option value="All">All</option>
        <option value="Electronics">Electronics</option>
        <option value="Fruits">Fruits</option>
        <option value="Clothing">Clothing</option>
      </select>

      <hr />

      {/* Display Filtered Items */}
      {filteredItems.length > 0 ? (
        filteredItems.map((item) => (
          <div
            key={item.id}
            style={{
              border: "1px solid gray",
              padding: "10px",
              marginBottom: "10px",
              borderRadius: "5px",
            }}
          >
            <h3>{item.name}</h3>
            <p>Category: {item.category}</p>
          </div>
        ))
      ) : (
        <h3>No items found.</h3>
      )}
    </div>
       </>
    );
}

export default AdminEmployeePage;